@@ -0,0 +1,52 @@
+import assert from "node:assert/strict"
+import { readFile } from "node:fs/promises"
+import test from "node:test"
+import { MINARI_DATASETS, NAMESPACES } from "../lib/minari-data.ts"
+
+const catalog = JSON.parse(await readFile(new URL("../lib/minari-catalog.generated.json", import.meta.url), "utf8"))
+const details = JSON.parse(await readFile(new URL("../lib/minari-details.generated.json", import.meta.url), "utf8"))
+const searchable = ["id", "envName", "datasetName", "description"]
+function matches(dataset, query, namespaces) {
+  const text = query.toLowerCase()
+  return (searchable.some((field) => dataset[field].toLowerCase().includes(text))
+    || dataset.tags.some((tag) => tag.toLowerCase().includes(text)))
+    && (namespaces.length === 0 || namespaces.includes(dataset.namespace))
+}
+
+test("catalogue retains every card/search value, order and unique dataset identity", () => {
+  assert.equal(catalog.datasets.length, MINARI_DATASETS.length)
+  assert.equal(new Set(catalog.datasets.map((dataset) => dataset.id)).size, MINARI_DATASETS.length)
+  catalog.datasets.forEach((entry, index) => {
+    for (const [key, value] of Object.entries(entry)) assert.deepEqual(value, MINARI_DATASETS[index][key])
+    assert.deepEqual({ ...entry, ...details[entry.id] }, MINARI_DATASETS[index])
+    assert.equal(Object.keys(entry).some((key) => key in details[entry.id]), false)
+  })
+  assert.deepEqual(catalog.namespaces, NAMESPACES)
+})
+
+test("search and every namespace combination retain the same results", () => {
+  const queries = new Set(["", "Atari", "aTaRi", "no-such-dataset", ...MINARI_DATASETS.flatMap((dataset) => [
+    ...searchable.map((field) => dataset[field]), ...dataset.tags,
+  ])])
+  for (let mask = 0; mask < 2 ** NAMESPACES.length; mask++) {
+    const namespaces = NAMESPACES.filter((_, index) => mask & (1 << index))
+    for (const query of queries) {
+      const ids = (datasets) => datasets.filter((dataset) => matches(dataset, query, namespaces)).map((dataset) => dataset.id)
+      assert.deepEqual(ids(catalog.datasets), ids(MINARI_DATASETS), `${query}: ${namespaces.join(",")}`)
+    }
+  }
+  assert.equal(catalog.datasets.filter((dataset) => matches(dataset, "Atari", [])).length, 5)
+})
+
+test("overview and namespace totals match the complete records", () => {
+  const totals = (datasets) => ({
+    datasets: datasets.length,
+    episodes: datasets.reduce((total, dataset) => total + dataset.totalEpisodes, 0),
+    steps: datasets.reduce((total, dataset) => total + dataset.totalSteps, 0),
+    downloads: datasets.reduce((total, dataset) => total + dataset.downloads, 0),
+  })
+  assert.deepEqual(catalog.totals, totals(MINARI_DATASETS))
+  assert.deepEqual(catalog.namespaceStats, NAMESPACES.map((name) => ({ name,
+    ...totals(MINARI_DATASETS.filter((dataset) => dataset.namespace === name)),
+  })))
+})
