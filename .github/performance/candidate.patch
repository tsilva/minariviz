@@ -0,0 +1,17 @@
+"use client"
+
+import { DatasetDetail } from "./dataset-detail"
+import { useMemo } from "react"
+import details from "@/lib/minari-details.generated.json"
+import type { MinariCatalogEntry } from "@/lib/minari-catalog"
+import type { MinariDataset } from "@/lib/minari-data"
+
+const metadata: Record<string, Omit<MinariDataset, keyof MinariCatalogEntry>> = details
+
+export function DatasetInspector({ entry }: { entry: MinariCatalogEntry }) {
+  const dataset = useMemo(() => {
+    if (!metadata[entry.id]) throw new Error(`Unknown dataset: ${entry.id}`)
+    return { ...entry, ...metadata[entry.id] }
+  }, [entry])
+  return <DatasetDetail dataset={dataset} />
+}
