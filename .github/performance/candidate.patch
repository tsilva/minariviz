+import catalog from "./minari-catalog.generated.json"
+import type { MinariDataset } from "./minari-data"
+
+export type MinariCatalogEntry = Pick<MinariDataset,
+  "id" | "namespace" | "envName" | "datasetName" | "version" | "totalEpisodes"
+  | "totalSteps" | "actionSpaceType" | "actionSpaceDims" | "observationSpaceType"
+  | "observationSpaceDims" | "description" | "tags">
+
+export const MINARI_CATALOG: MinariCatalogEntry[] = catalog.datasets
+export const NAMESPACES = catalog.namespaces
+export const CATALOG_TOTALS = catalog.totals
+export const NAMESPACE_STATS = catalog.namespaceStats
