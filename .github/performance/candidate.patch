+++ b/scripts/generate-minari-catalog.mjs
@@ -0,0 +1,40 @@
+import { readFile, writeFile } from "node:fs/promises"
+import { MINARI_DATASETS, NAMESPACES } from "../lib/minari-data.ts"
+
+const fields = [
+  "id", "namespace", "envName", "datasetName", "version", "totalEpisodes",
+  "totalSteps", "actionSpaceType", "actionSpaceDims", "observationSpaceType",
+  "observationSpaceDims", "description", "tags",
+]
+const sum = (datasets, field) => datasets.reduce((total, dataset) => total + dataset[field], 0)
+const catalog = {
+  datasets: MINARI_DATASETS.map((dataset) => Object.fromEntries(fields.map((field) => [field, dataset[field]]))),
+  namespaces: NAMESPACES,
+  totals: {
+    datasets: MINARI_DATASETS.length,
+    episodes: sum(MINARI_DATASETS, "totalEpisodes"),
+    steps: sum(MINARI_DATASETS, "totalSteps"),
+    downloads: sum(MINARI_DATASETS, "downloads"),
+  },
+  namespaceStats: NAMESPACES.map((name) => {
+    const datasets = MINARI_DATASETS.filter((dataset) => dataset.namespace === name)
+    return { name, datasets: datasets.length, episodes: sum(datasets, "totalEpisodes"),
+      steps: sum(datasets, "totalSteps"), downloads: sum(datasets, "downloads") }
+  }),
+}
+const output = JSON.stringify(catalog, null, 2) + "\n"
+const details = Object.fromEntries(MINARI_DATASETS.map((dataset) => [dataset.id,
+  Object.fromEntries(Object.entries(dataset).filter(([field]) => !fields.includes(field))),
+]))
+for (const [name, content] of [
+  ["minari-catalog.generated.json", output],
+  ["minari-details.generated.json", JSON.stringify(details, null, 2) + "\n"],
+]) {
+  const target = new URL(`../lib/${name}`, import.meta.url)
+  if (process.argv.includes("--check")) {
+    const current = await readFile(target, "utf8")
+    if (current !== content) throw new Error("Catalogue is stale; run pnpm catalog:generate")
+  } else {
+    await writeFile(target, content)
+  }
+}
